	local function slider(parent, title, min, max, step, default, fmt, callback)

		local row = card(parent, 58)

		text(row, { Size = UDim2.new(0.6, 0, 0, 18), Position = UDim2.fromOffset(14, 9), Text = title, Font = FONT_MED })

		local valueLbl = text(row, { Size = UDim2.new(0.4, -14, 0, 18), Position = UDim2.new(0.6, 0, 0, 9), Font = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Right })

		local track = new("Frame", { Size = UDim2.new(1, -28, 0, 6), Position = UDim2.fromOffset(14, 40), BackgroundColor3 = Theme.off, BorderSizePixel = 0 }, row)

		round(track, 3)

		local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Theme.accent, BorderSizePixel = 0 }, track)

		round(fill, 3)

		local knob = new("Frame", { Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 2 }, track)

		round(knob, 7)

		local hit = new("TextButton", { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 0.5, -14), BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, track)

		onAccent(function() fill.BackgroundColor3 = Theme.accent valueLbl.TextColor3 = Theme.accentHover end)

		local scroller = parent:IsA("ScrollingFrame") and parent or nil

		local api = { Row = row }

		function api.Set(v, silent)

			v = tonumber(v) or tonumber(default) or min

			v = math.clamp(math.floor((v - min) / step + 0.5) * step + min, min, max)

			local a = (v - min) / (max - min)

			fill.Size = UDim2.new(a, 0, 1, 0)

			knob.Position = UDim2.new(a, 0, 0.5, 0)

			valueLbl.Text = fmt(v)

			if not silent and callback then callback(v) end

		end

		local dragging = false

		local function fromX(x)

			local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)

			api.Set(min + a * (max - min))

		end

		local function stopDrag()

			if dragging then

				dragging = false

				if scroller then scroller.ScrollingEnabled = true end

			end

		end

		hit.InputBegan:Connect(function(input)

			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then

				dragging = true

				if scroller then scroller.ScrollingEnabled = false end

				fromX(input.Position.X)

			end

		end)

		trackConn(UserInputService.InputChanged:Connect(function(input)

			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then fromX(input.Position.X) end

		end))

		trackConn(UserInputService.InputEnded:Connect(function(input)

			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then stopDrag() end

		end))

		api.Set(default, true)

		return api

	end

