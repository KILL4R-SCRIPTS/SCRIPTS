local oldNamecall = nil
if ClickGuardLogRemote and type(hookmetamethod) == "function" and type(getnamecallmethod) == "function" and type(checkcaller) == "function" then
	pcall(function()
		oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
			if state.clickGuardBypass and not checkcaller() and self == ClickGuardLogRemote then
				return true
			end
			return oldNamecall(self, ...)
		end)
	end)
end
if ClickGuardLogRemote and type(hookfunction) == "function" and type(checkcaller) == "function" then
	pcall(function()
		local oldFire
		oldFire = hookfunction(ClickGuardLogRemote.FireServer, function(self, ...)
			if state.clickGuardBypass and not checkcaller() and self == ClickGuardLogRemote then
				return nil
			end
			return oldFire(self, ...)
		end)
	end)
end

local disabledClickConns = {}
local function applyAutoclickerBypass(enabled)
	if enabled then
		if type(getconnections) == "function" then
			pcall(function()
				for _, sig in ipairs({ UserInputService.InputBegan, UserInputService.InputEnded }) do
					for _, cn in ipairs(getconnections(sig)) do
						local f = cn.Function
						if f and cn.Enabled then
							local env = getfenv(f)
							local scr = env and env.script
							local sName = scr and scr.Name or ""
							if sName:find("ClickGuard") or sName == "Dump" or sName:find("AntiCheat") or sName:find("Macro") then
								cn:Disable()
								table.insert(disabledClickConns, cn)
							end
						end
					end
				end
			end)
		end
	else
		for _, cn in ipairs(disabledClickConns) do
			pcall(function() cn:Enable() end)
		end
		table.clear(disabledClickConns)
	end
end
applyAutoclickerBypass(state.clickGuardBypass)

