local function computeTelekinesis()

	if InputController and InputController._rotateMouseEvent ~= nil then return true end

	if AbilityController and (AbilityController.CurrentAbility == "Telekinesis" and AbilityController.Holding == true) then return true end

	local c = LocalPlayer.Character

	if not c then return false end

	if c:GetAttribute("Grabbing") == true or c:GetAttribute("HoldingTarget") == true or c:GetAttribute("Choking") == true then

		return true

	end

	for _, n in ipairs(TK_ACTIVE_WELDS) do

		if c:FindFirstChild(n) then return true end

	end

	local ci = c:FindFirstChild("CharacterInfo")

	local eff = ci and ci:FindFirstChild("Effects")

	if eff then

		for _, n in ipairs(TK_ACTIVE_EFFECTS) do

			if eff:FindFirstChild(n) then return true end

		end

	end

	return false

end



local function computeShield()

	local c = LocalPlayer.Character

