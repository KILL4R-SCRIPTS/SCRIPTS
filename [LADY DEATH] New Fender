local function clearEspEntry(entry)
	if not entry then return end
	if entry.hl then pcall(function() entry.hl:Destroy() end) end
	if entry.bb then pcall(function() entry.bb:Destroy() end) end
end

local function updateESP()
	local myHrp = getHRP()
	local activePlayers = {}
	if state.playerEsp then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character then
				local c = p.Character
				local hrp = getHRP(c)
				local hum = c:FindFirstChildOfClass("Humanoid")
				if hrp and hum and hum.Health > 0 then
					activePlayers[p] = true
					local entry = espMap[p]
					if not entry or not entry.hl or entry.hl.Parent ~= c or not entry.bb or entry.bb.Parent ~= hrp then
						clearEspEntry(entry)
						local hl = Instance.new("Highlight")
						hl.Name = "KW_PlayerHighlight"
						hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						hl.FillTransparency = 0.78
						hl.OutlineTransparency = 0.05
						hl.FillColor = isFriend(p) and Color3.fromRGB(90, 230, 145) or Color3.fromRGB(185, 95, 255)
						hl.OutlineColor = Color3.fromRGB(255, 255, 255)
						hl.Adornee = c
						hl.Parent = c

						local bb = Instance.new("BillboardGui")
						bb.Name = "KW_PlayerTag"
						bb.Size = UDim2.fromOffset(190, 38)
						bb.StudsOffset = Vector3.new(0, 4.3, 0)
						bb.AlwaysOnTop = true
						bb.MaxDistance = math.huge
						bb.LightInfluence = 0
						bb.ResetOnSpawn = false
						bb.Adornee = hrp
						bb.Parent = hrp

						local lbl = Instance.new("TextLabel")
						lbl.Size = UDim2.fromScale(1, 1)
						lbl.BackgroundTransparency = 1
						lbl.Font = Enum.Font.GothamBold
						lbl.TextSize = 12
						lbl.TextStrokeTransparency = 0.2
						lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
						lbl.TextColor3 = isFriend(p) and Color3.fromRGB(140, 255, 180) or Color3.fromRGB(245, 235, 255)
						lbl.Parent = bb

						entry = { hl = hl, bb = bb, lbl = lbl }
						espMap[p] = entry
					end
					local dist = myHrp and math.floor((hrp.Position - myHrp.Position).Magnitude) or 0
					local cv = c:FindFirstChild("CharacterValues")
					local chNameVal = cv and cv:FindFirstChild("CharacterName")
					local chName = (chNameVal and chNameVal:IsA("StringValue") and chNameVal.Value ~= "" and chNameVal.Value)
						or p:GetAttribute("LastCharacter") or "Witch"
					entry.lbl.Text = string.format("%s [%s]\n%d/%d HP â€¢ %dm", p.Name, tostring(chName), math.floor(hum.Health), math.floor(hum.MaxHealth), dist)
				end
			end
		end
	end
	for p, entry in pairs(espMap) do
		if not activePlayers[p] then clearEspEntry(entry) espMap[p] = nil end
	end

	local activeWorld = {}
	if state.collectibleEsp then
		local function watchObj(inst, label, col)
			if not inst or not inst.Parent then return end
			local part = inst:IsA("BasePart") and inst or inst:FindFirstChildWhichIsA("BasePart", true)
			if not part then return end
			activeWorld[inst] = true
			local entry = worldEspMap[inst]
			if not entry or not entry.bb or entry.bb.Parent ~= part then
				clearEspEntry(entry)
				local bb = Instance.new("BillboardGui")
				bb.Name = "KW_WorldTag"
				bb.Size = UDim2.fromOffset(150, 24)
				bb.StudsOffset = Vector3.new(0, 2.5, 0)
				bb.AlwaysOnTop = true
				bb.MaxDistance = math.huge
				bb.LightInfluence = 0
				bb.Adornee = part
				bb.Parent = part
				local lbl = Instance.new("TextLabel")
				lbl.Size = UDim2.fromScale(1, 1)
				lbl.BackgroundTransparency = 1
				lbl.Font = Enum.Font.GothamBold
				lbl.TextSize = 11
				lbl.TextStrokeTransparency = 0.2
				lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
				lbl.TextColor3 = col
				lbl.Parent = bb
				entry = { bb = bb, lbl = lbl }
				worldEspMap[inst] = entry
			end
			local dist = myHrp and math.floor((part.Position - myHrp.Position).Magnitude) or 0
			entry.lbl.Text = string.format("%s (%dm)", label, dist)
		end

		local orbs = workspace:FindFirstChild("LumenOrbs")
		if orbs then
			for _, o in ipairs(orbs:GetChildren()) do watchObj(o, "Lumen Orb", Color3.fromRGB(210, 150, 255)) end
		end
		local shrooms = workspace:FindFirstChild("Spellshrooms")
		if shrooms then
			for _, s in ipairs(shrooms:GetChildren()) do watchObj(s, "Spellshroom", Color3.fromRGB(255, 130, 180)) end
		end
		local hp = workspace:FindFirstChild("HealingPool")
		if hp then watchObj(hp, "Healing Pool", Color3.fromRGB(100, 255, 160)) end
	end
	for inst, entry in pairs(worldEspMap) do
		if not activeWorld[inst] then clearEspEntry(entry) worldEspMap[inst] = nil end
	end
end

local lastEspAt = 0
trackConn(RunService.RenderStepped:Connect(function()
	if not state.playerEsp and not state.collectibleEsp then
		if next(espMap) ~= nil or next(worldEspMap) ~= nil then pcall(updateESP) end
		return
	end
	local now = os.clock()
	if (now - lastEspAt) >= 0.2 then
		lastEspAt = now
		pcall(updateESP)
	end
end))

