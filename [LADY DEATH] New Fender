		local function findActiveTotemOrCrucifix()

			-- 1. Check state cache

			if state.latestTotemPart and state.latestTotemPart.Parent then

				return state.latestTotemPart, state.latestTotemType or "Totem"

			end

			-- 2. Comprehensive workspace scan

			for _, obj in ipairs(workspace:GetDescendants()) do

				if obj:IsA("Model") then

					local nl = obj.Name:lower()

					if nl == "totem" or nl:find("crucifix") then

						local part = obj.PrimaryPart or obj:FindFirstChild("Mesh") or obj:FindFirstChild("Totem") or obj:FindFirstChildOfClass("BasePart")

						if part then

							local isCruc = nl:find("crucifix") or (obj:FindFirstChild("Break") and obj.Break:IsA("Sound") and obj.Break.SoundId:find("3750957896"))

							return part, isCruc and "Crucifix" or "Totem"

						end

					end

				elseif obj:IsA("ProximityPrompt") then

					local pnl = obj.Name:lower()

					local anl = obj.ActionText:lower()

					local onl = obj.ObjectText:lower()

					if pnl:find("totem") or pnl:find("crucifix") or anl:find("totem") or onl:find("totem") or onl:find("crucifix") or anl:find("destroy") then

						local part = obj.Parent

						if part and part:IsA("Attachment") then part = part.Parent end

						if part and part:IsA("BasePart") then

							return part, onl:find("crucifix") and "Crucifix" or "Totem"

						end

					end

				end

			end

			return nil, nil

		end

