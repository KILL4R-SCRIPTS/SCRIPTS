		text(outer, { Size = UDim2.new(1, -(rightX + 14), 0, 16), Position = UDim2.fromOffset(rightX, 36), Text = "BRIGHTNESS", TextColor3 = Theme.sub, Font = FONT_BOLD, TextSize = 9 })

