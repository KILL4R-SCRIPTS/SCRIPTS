			local center = wheel.AbsolutePosition + wheel.AbsoluteSize / 2

			local offset = Vector2.new(input.Position.X - center.X, input.Position.Y - center.Y)

			local radius = wheel.AbsoluteSize.X / 2

			local dist = math.min(offset.Magnitude, radius - 2)

			local angle = math.atan2(offset.Y, offset.X)

			currentHue = ((0.5 - angle / (2 * math.pi)) % 1 + 1) % 1

			currentSat = math.clamp(dist / radius, 0, 1)

			sync(false)

		end

		wheel.InputBegan:Connect(function(input)

			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then

				wheelDragging = true

				handleWheelInput(input)

			end

		end)

		UserInputService.InputChanged:Connect(function(input)

			if wheelDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then

				handleWheelInput(input)

			end

		end)

		UserInputService.InputEnded:Connect(function(input)

			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then

				wheelDragging = false

			end

		end)

		-- Drag logic on brightness

		local valDragging = false

		local function handleValInput(input)

			local a = math.clamp((input.Position.X - valTrack.AbsolutePosition.X) / math.max(valTrack.AbsoluteSize.X, 1), 0, 1)

			currentVal = a

			sync(false)

		end

		valHit.InputBegan:Connect(function(input)

			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then

				valDragging = true

				handleValInput(input)

			end

		end)

		UserInputService.InputChanged:Connect(function(input)

			if valDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then

				handleValInput(input)

			end

		end)

		UserInputService.InputEnded:Connect(function(input)

			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then

				valDragging = false

			end

		end)

		-- Hex input listener

		hexInput.FocusLost:Connect(function()

			local raw = hexInput.Text:gsub("#", ""):gsub("%s+", "")

			if #raw == 6 then

				local s, col = pcall(function() return Color3.fromHex(raw) end)

				if s and col then

					local h, s2, v = col:ToHSV()

					currentHue = h

					currentSat = s2

					currentVal = v

					sync(false)

				end

			end

		end)

		task.defer(function()

			updatePickerPos()

			sync(true)

		end)

		local api = { Outer = outer }

		function api.SetColor(col, silent)

			local h, s, v = col:ToHSV()

			currentHue = h

			currentSat = s

			currentVal = v

			sync(silent)

		end

		function api.GetColor() return currentColor end

		return api

	end

