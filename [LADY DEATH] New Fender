if isNewFender and AbilityUtilities and AbilityUtilities.GetPlayerNearMouse then

	oldGetPlayerNearMouse = AbilityUtilities.GetPlayerNearMouse

	AbilityUtilities.GetPlayerNearMouse = function(self, maxDist, arg64)

		if not state.customRangeEnabled then return oldGetPlayerNearMouse(self, maxDist, arg64) end

		local myChar = (self and self.GetActiveCharacter and self:GetActiveCharacter()) or LocalPlayer.Character

		local myPrimary = myChar and myChar.PrimaryPart

		local cam = workspace.CurrentCamera

		if not myPrimary or not cam then return oldGetPlayerNearMouse(self, maxDist, arg64) end

		-- Strictly enforce maximum ability reach so abilities never fire out of range

		local numMaxDist = tonumber(maxDist)

		local effectiveRange = (numMaxDist and numMaxDist > 0) and (numMaxDist + 4) or (state.customRangeDistance or 150)

		local mouseVec = getMouseVec()

		local bestChar, bestScreenDist = nil, math.huge

		local nearestWorldChar, nearestWorldDist = nil, math.huge

		local chars = (self and self.GetCharacters) and self:GetCharacters((not arg64) and LocalPlayer.Character or nil) or {}

		local excludeFriend = state.excludeFriends and isOutspammerActive

		for _, ch in ipairs(chars) do

			if (arg64 or ch ~= myChar) and ch.PrimaryPart then

				if not (excludeFriend and isFriend(ch)) then

					local hum = ch:FindFirstChildOfClass("Humanoid")

					if hum and hum.Health > 0 and not ch:GetAttribute("Inmortal") and not ch:GetAttribute("EmmaAstralBody")  then

						local worldDist = (ch.PrimaryPart.Position - myPrimary.Position).Magnitude

						if worldDist <= effectiveRange then

							if worldDist < nearestWorldDist then

								nearestWorldDist = worldDist

								nearestWorldChar = ch

							end

							if not state.nearestTargetMode then

								local screenPos, onScreen = cam:WorldToScreenPoint(ch.PrimaryPart.Position)

								if onScreen then

									local sDist = (Vector2.new(screenPos.X, screenPos.Y) - mouseVec).Magnitude

									if sDist < bestScreenDist then

										bestScreenDist = sDist

										bestChar = ch

									end

								end

							end

						end

					end

				end

			end

		end

		local chosen = state.nearestTargetMode and nearestWorldChar or (bestChar or nearestWorldChar)

		if chosen then

			local dist = (chosen.PrimaryPart.Position - myPrimary.Position).Magnitude

			if dist <= effectiveRange then

				return chosen

			end

		end

		-- If excludeFriends filtered candidates or no non-friend enemy is in range,

		-- fall back to native targeting so the user is NEVER blocked from hitting friends!

		if oldGetPlayerNearMouse then

			return oldGetPlayerNearMouse(self, maxDist, arg64)

		end

		return nil

	end

end



