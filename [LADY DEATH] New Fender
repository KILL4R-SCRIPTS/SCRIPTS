local activeRecoloredInstances = setmetatable({}, { __mode = "k" })



local function recolorSingleInstance(inst, targetCol)

	if not inst or not inst.Parent then return end

	pcall(function()

		local seq = ColorSequence.new(targetCol)

		if inst:IsA("ParticleEmitter") then

			inst.Color = seq

			activeRecoloredInstances[inst] = true

		elseif inst:IsA("Beam") then

			inst.Color = seq

			activeRecoloredInstances[inst] = true

		elseif inst:IsA("Trail") then

			inst.Color = seq

			activeRecoloredInstances[inst] = true

		elseif inst:IsA("PointLight") or inst:IsA("SpotLight") or inst:IsA("SurfaceLight") then

			inst.Color = targetCol

			activeRecoloredInstances[inst] = true

		elseif inst:IsA("Highlight") then

			inst.FillColor = targetCol

			inst.OutlineColor = targetCol:Lerp(Color3.new(1, 1, 1), 0.35)

			activeRecoloredInstances[inst] = true

		elseif inst:IsA("Fire") then

			inst.Color = targetCol

			inst.SecondaryColor = targetCol:Lerp(Color3.new(1, 1, 1), 0.25)

			activeRecoloredInstances[inst] = true

		elseif inst:IsA("Sparkles") then

			inst.SparkleColor = targetCol

			activeRecoloredInstances[inst] = true

		elseif inst:IsA("BasePart") then

			local n = inst.Name:lower()

			if inst.Material == Enum.Material.Neon or n:find("beam") or n:find("spell") or n:find("blast") or n:find("orb") or n:find("aura") or n:find("hitbox") or n:find("shield") or n:find("projectile") then

				inst.Color = targetCol

				activeRecoloredInstances[inst] = true

			end

		end

	end)

end



local function shouldRecolor(inst)

	if not state.powerRecolor then return false end

	local char = LocalPlayer.Character

	if not char then return false end

	-- Only visual spell particles, beams, trails, lights, fire, smoke

	if not (inst:IsA("ParticleEmitter") or inst:IsA("Beam") or inst:IsA("Trail") or inst:IsA("PointLight") or inst:IsA("SpotLight") or inst:IsA("SurfaceLight") or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Highlight")) then

		return false

	end

	-- 1. Descendant of local player's character (excluding basic head/body decals)

	if inst:IsDescendantOf(char) then

		if inst.Parent and (inst.Parent.Name == "Head" or inst.Parent.Name == "HumanoidRootPart") and inst:IsA("Decal") then

			return false

		end

		return true

	end

	-- 2. Visual effects inside workspace VFX / Projectiles created by or owned by local player

	local vfx = workspace:FindFirstChild("VFX") or workspace:FindFirstChild("Projectiles")

	if vfx and inst:IsDescendantOf(vfx) then

		local top = inst

		while top.Parent and top.Parent ~= vfx and top.Parent ~= workspace do

			top = top.Parent

		end

		if top:GetAttribute("Owner") == LocalPlayer.Name or top:GetAttribute("Creator") == LocalPlayer.Name or top.Name:find(LocalPlayer.Name, 1, true) then

			return true

		end

	end

	return false

end



applyPowerRecolorToActive = function(forceAll)

	if not state.powerRecolor and not forceAll then return end

	local targetCol = state.powerRecolorColor or Color3.fromRGB(0, 235, 117)

	local char = LocalPlayer.Character

	if char then

		for _, d in ipairs(char:GetDescendants()) do

			if shouldRecolor(d) then

				recolorSingleInstance(d, targetCol)

			end

		end

	end

	local vfx = workspace:FindFirstChild("VFX") or workspace:FindFirstChild("Projectiles")

	if vfx then

		for _, d in ipairs(vfx:GetDescendants()) do

			if shouldRecolor(d) then

				recolorSingleInstance(d, targetCol)

			end

		end

	end

end



local function hookPowerRecolorOnChar(c)

	if not c then return end

	c.DescendantAdded:Connect(function(d)

		if state.powerRecolor and shouldRecolor(d) then

			recolorSingleInstance(d, state.powerRecolorColor or Color3.fromRGB(0, 235, 117))

		end

	end)

end



LocalPlayer.CharacterAdded:Connect(hookPowerRecolorOnChar)

if LocalPlayer.Character then hookPowerRecolorOnChar(LocalPlayer.Character) end

