local fpsBoostOriginals = {}



local function applyFpsBooster(enable)

	state.fpsBooster = enable

	pcall(function()

		if enable then

			fpsBoostOriginals.GlobalShadows = Lighting.GlobalShadows

			fpsBoostOriginals.FogEnd = Lighting.FogEnd

			Lighting.GlobalShadows = false

			Lighting.FogEnd = 9e9

			if workspace:FindFirstChildOfClass("Terrain") then

				fpsBoostOriginals.Decoration = workspace.Terrain.Decoration

				workspace.Terrain.Decoration = false

			end

			for _, d in ipairs(workspace:GetDescendants()) do

				if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then

					if d.Enabled then

						fpsBoostOriginals[d] = true

						d.Enabled = false

					end

				elseif d:IsA("BasePart") then

					if d.CastShadow then

						fpsBoostOriginals[d] = true

						d.CastShadow = false

					end

				end

			end

		else

			if fpsBoostOriginals.GlobalShadows ~= nil then

				Lighting.GlobalShadows = fpsBoostOriginals.GlobalShadows

			end

			if fpsBoostOriginals.FogEnd ~= nil then

				Lighting.FogEnd = fpsBoostOriginals.FogEnd

			end

			if workspace:FindFirstChildOfClass("Terrain") and fpsBoostOriginals.Decoration ~= nil then

				workspace.Terrain.Decoration = fpsBoostOriginals.Decoration

			end

			for obj in pairs(fpsBoostOriginals) do

				if typeof(obj) == "Instance" and obj.Parent then

					if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then

						obj.Enabled = true

					elseif obj:IsA("BasePart") then

						obj.CastShadow = true

					end

				end

			end

			table.clear(fpsBoostOriginals)

		end

	end)

end



local ownAllOriginals = nil

local ownAllLoopConn = nil



local function applyOwnAllCharacters(enable)

	state.ownAllCharacters = enable

	pcall(function()

		local Knit_m = pcall(function() return require(ReplicatedStorage.Modules.Knit) end) and require(ReplicatedStorage.Modules.Knit)

		local mc = Knit_m and pcall(function() return Knit_m.GetController("MenuController") end) and Knit_m.GetController("MenuController")

		local charsMod = pcall(function() return require(ReplicatedStorage.Modules.Characters) end) and require(ReplicatedStorage.Modules.Characters)

		if enable then

			if mc and charsMod then

				if not ownAllOriginals then

					ownAllOriginals = mc.OwnedCharacters or {}

				end

				local all = {}

				for k, v in pairs(charsMod) do

					if type(v) == "table" and k ~= "Products" and k ~= "Gamepasses" and k ~= "ProductIdToGamepassId" and k ~= "Placeholder" then

						table.insert(all, k)

					end

				end

				mc.OwnedCharacters = all

			end

			local function refreshMenuLocks()

				if not state.ownAllCharacters then return end

				local pgui = LocalPlayer:FindFirstChildOfClass("PlayerGui")

				local menu = pgui and pgui:FindFirstChild("Menu")

				local selUI = menu and menu:FindFirstChild("SelectionUI")

				if not selUI then return end

				local scroll = selUI:FindFirstChild("Selection", true)

				local sf = scroll and scroll:FindFirstChild("ScrollingFrame", true)

				if sf then

					for _, btn in ipairs(sf:GetChildren()) do

						local lock = btn:FindFirstChild("Lock")

						if lock then lock.Visible = false end

					end

				end

				local skins = selUI:FindFirstChild("Skins", true)

				if skins then

					for _, btn in ipairs(skins:GetChildren()) do

						local lock = btn:FindFirstChild("Lock")

						if lock then lock.Visible = false end

					end

				end

				local price = selUI:FindFirstChild("Price", true)

				if price and price.Visible then

					price.Visible = false

				end

				local deploy = selUI:FindFirstChild("Deploy", true)

				if deploy and not deploy.Visible then

					deploy.Visible = true

					deploy.ImageColor3 = Color3.fromRGB(255, 255, 255)

					local lbl = deploy:FindFirstChild("Label", true)

					if lbl then lbl.Text = "DEPLOY" end

				end

			end

			refreshMenuLocks()

			if not ownAllLoopConn then

				ownAllLoopConn = RunService.Heartbeat:Connect(function()

					if state.ownAllCharacters then

						pcall(refreshMenuLocks)

					end

				end)

				trackConn(ownAllLoopConn)

			end

		else

			if mc and ownAllOriginals then

				mc.OwnedCharacters = ownAllOriginals

			end

			if ownAllLoopConn then

				ownAllLoopConn:Disconnect()

				ownAllLoopConn = nil

			end

		end

	end)

end



