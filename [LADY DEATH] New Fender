local function findHereticKeyFromHud()

	local profile = getAuthoritativeProfile()

	if not profile then return nil end

	for _, d in ipairs(profile:GetDescendants()) do

		local hit = mentionsHeretic(d.Name)

		if not hit and (d:IsA("TextLabel") or d:IsA("TextButton")) then

			hit = mentionsHeretic(d.Text)

		end

		if not hit then

			for _, v in pairs(d:GetAttributes()) do

				if mentionsHeretic(v) then hit = true break end

			end

		end

		if hit then

			local p = d

			while p and p ~= profile do

				if ABILITY_KEYS[p.Name] then return p.Name end

				p = p.Parent

			end

		end

	end

	return nil

end



local function searchTableForHeretic(tbl, depth, seen, parentKey)

	if type(tbl) ~= "table" or depth > 5 or seen[tbl] then return nil end

	seen[tbl] = true

	local hit = false

	for k, v in pairs(tbl) do

		if mentionsHeretic(k) or mentionsHeretic(v) then

			hit = true

			if type(v) == "table" and mentionsHeretic(k) then

				local nested = keyFromTable(v)

				if nested then return nested end

			end

		end

	end

	if hit then

		local direct = keyFromTable(tbl)

		if direct then return direct end

		local viaParent = parentKey and asAbilityKey(parentKey)

		if viaParent then return viaParent end

	end

	for k, v in pairs(tbl) do

		if type(v) == "table" then

			local r = searchTableForHeretic(v, depth + 1, seen, type(k) == "string" and k or nil)

			if r then return r end

		end

	end

	return nil

end



local function findHereticKeyFromData()

	if type(CharactersData) ~= "table" then return nil end

	local c = LocalPlayer.Character

	local tag = c and (c:GetAttribute("NameTag") or c:GetAttribute("Character"))

	local ids = {}

	if tag and CharactersData[tag] then table.insert(ids, tag) end

	for id in pairs(CharactersData) do

		if type(id) == "string" and id ~= tag and normId(id):find("josie", 1, true) then

			table.insert(ids, id)

		end

	end

	for _, id in ipairs(ids) do

		local ok, res = pcall(searchTableForHeretic, CharactersData[id], 0, {}, nil)

		if ok and res then return res end

	end

	return nil

end



local function pressAbilityOnce(key)

	if not AbilityController then return false, "unavailable" end

	local cd = AbilityController.Cooldowns

	if cd and cd[key] == true then return false, "cooldown" end

	local cur = AbilityController.CurrentAbility

	if cur and cur ~= key and cur ~= "Fly" then

		cancelPreviousAbility(key)

	end

	local btn = getHudButtonForKey(key)

	if string.find(key, "ExtraKey", 1, true) and AbilityController._pressExtra then

		task.spawn(AbilityController._pressExtra, btn, key)

	elseif AbilityController._keyDown then

		task.spawn(AbilityController._keyDown, btn, key)

	elseif AbilityController.KeyDown then

		AbilityController.KeyDown:Fire(btn, key)

	else

		return false, "unavailable"

	end

	task.defer(confirmActiveAbilityListener)

	task.delay(0.2, function() pcall(sendRelease, key) end)

	return true

end



local function triggerHereticTurn()

	if not isNewFender then return false, "New Fender only" end

	if not AbilityController then return false, "abilities not loaded" end

	-- 1. Check if HereticsConfirm GUI is open / visible and click Confirm

	local confirmedPrompt = false

	pcall(function()

		local prof = PlayerGui:FindFirstChild("Profile")

		local hc = prof and prof:FindFirstChild("HereticsConfirm")

		if hc and hc.Visible then

			local confirmBtn = hc:FindFirstChild("Confirm")

			if confirmBtn then

				if getconnections then

					for _, conn in ipairs(getconnections(confirmBtn.MouseButton1Click)) do

						pcall(function() conn:Fire() end)

					end

				end

				if confirmBtn.MouseButton1Click then

					pcall(function() confirmBtn.MouseButton1Click:Fire() end)

				end

				confirmedPrompt = true

			end

		end

	end)

	if confirmedPrompt then return true, "confirmed prompt" end

	-- 2. Detect character

	local charName = nil

	pcall(function()

		local c = LocalPlayer.Character

		charName = c and c.Name

		if not charName and AbilityController and AbilityController.AbilityModule then

			charName = AbilityController.AbilityModule.Name

		end

	end)

	-- 3. If playing Josie (DarkJosie, DarkJosieNoir, DarkJosieProm) -> fire ExtraKey5

	local isJosie = isJosieCharacter(LocalPlayer.Character) or (charName and charName:lower():find("josie", 1, true) ~= nil)

	if isJosie then

		local ok = pressAbilityOnce("ExtraKey5")

		if ok then return true, "ExtraKey5" end

		for _, k in ipairs({ "ExtraKey5", "ExtraKey4", "ExtraKey3", "ExtraKey1" }) do

			if pressAbilityOnce(k) then return true, k end

		end

	end

	-- 4. If playing Heretic characters (TheDevious, TheArrogant, TheBloodborn) -> fire ExtraKey3 (Invite)

	local isHereticCaster = charName and (charName == "TheDevious" or charName == "TheArrogant" or charName == "TheBloodborn")

	if isHereticCaster then

		local ok = pressAbilityOnce("ExtraKey3")

		if ok then return true, "ExtraKey3" end

	end

	-- 5. Fallback between ExtraKey5 and ExtraKey3

	local ok5 = pressAbilityOnce("ExtraKey5")

	if ok5 then return true, "ExtraKey5" end

	local ok3 = pressAbilityOnce("ExtraKey3")

	if ok3 then return true, "ExtraKey3" end

	return false, "ability not found"

end



