local DEFAULT_POWER_COLOR = Color3.fromRGB(250, 204, 21)

local COLOR_ATTRS = { "PowerColor", "AbilityColor", "AuraColor", "ThemeColor", "MainColor", "EffectColor", "Color" }

local COLOR_FIELDS = { "PowerColor", "AbilityColor", "AuraColor", "ThemeColor", "MainColor", "Color", "Colour" }

local FALLBACK_POWER_COLORS = {

	scarletwitch = Color3.fromRGB(239, 68, 68),

	agathaharkness = Color3.fromRGB(168, 85, 247),

	jeangrey = Color3.fromRGB(249, 115, 22),

	storm = Color3.fromRGB(147, 197, 253),

	raven = Color3.fromRGB(139, 92, 246),

	sabrina = Color3.fromRGB(244, 114, 182),

	katara = Color3.fromRGB(56, 189, 248),

	eleven = Color3.fromRGB(251, 113, 133),

	bonnie = Color3.fromRGB(74, 222, 128),

	tessa = Color3.fromRGB(45, 212, 191),

}



local function normId(s) return (tostring(s):lower():gsub("[%s_%-]", "")) end



local function toColor3(v)

	local t = typeof(v)

	if t == "Color3" then return v end

	if t == "BrickColor" then return v.Color end

	if t == "ColorSequence" then return v.Keypoints[1].Value end

	if t == "string" then

		local hex = v:match("^#?(%x%x%x%x%x%x)$")

		if hex then

			local ok, c = pcall(Color3.fromHex, hex)

			if ok then return c end

		end

		local r, g, b = v:match("^(%d+)%s*,%s*(%d+)%s*,%s*(%d+)$")

		if r then return Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b)) end

		return nil

	end

	if t == "table" then

		if v.R and v.G and v.B then

			if v.R <= 1 and v.G <= 1 and v.B <= 1 then return Color3.new(v.R, v.G, v.B) end

			return Color3.fromRGB(v.R, v.G, v.B)

		end

		if v[1] and v[2] and v[3] then return Color3.fromRGB(v[1], v[2], v[3]) end

	end

	return nil

end



local function colorScore(c) local _, s, v = c:ToHSV() return s * v end



local function scanModelForColor(model)

	local best, bestScore = nil, 0.25

	local n = 0

	for _, d in ipairs(model:GetDescendants()) do

		n += 1

		if n > 600 then break end

		if d:IsA("Light") then

			local sc = colorScore(d.Color)

			if sc > bestScore then best, bestScore = d.Color, sc end

		elseif d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") then

			for _, kp in ipairs(d.Color.Keypoints) do

				local sc = colorScore(kp.Value)

				if sc > bestScore then best, bestScore = kp.Value, sc end

			end

		elseif d:IsA("BasePart") and d.Material == Enum.Material.Neon then

			local sc = colorScore(d.Color)

			if sc > bestScore then best, bestScore = d.Color, sc end

		end

	end

	return best

end



local colorByIdCache = {}

local colorSourceById = {}



local function resolvePowerColor(id)

	local result, source = nil, nil

	local parentId = nil

	if CharactersData then

		local cd = CharactersData[id]

		if type(cd) == "table" then

			parentId = cd.Parent or cd.ShareSlotWith

			for _, f in ipairs(COLOR_FIELDS) do

				result = toColor3(cd[f])

				if result then break end

			end

			if not result and parentId then

				local pd = CharactersData[parentId]

				if type(pd) == "table" then

					for _, f in ipairs(COLOR_FIELDS) do

						result = toColor3(pd[f])

						if result then break end

					end

				end

			end

			if result then source = "game data" end

		end

	end

	if not result and Morphs then

		for _, lookup in ipairs({ id, parentId }) do

			local m = lookup and Morphs:FindFirstChild(lookup)

			if m then

				for _, a in ipairs(COLOR_ATTRS) do

					result = toColor3(m:GetAttribute(a))

					if result then source = "morph attribute" break end

				end

				if not result then

					result = scanModelForColor(m)

					if result then source = "morph effects" end

				end

			end

			if result then break end

		end

	end

	if not result then

		result = FALLBACK_POWER_COLORS[normId(id)] or (parentId and FALLBACK_POWER_COLORS[normId(parentId)])

		if result then source = "fallback table" end

	end

	if not result then result = DEFAULT_POWER_COLOR source = "default" end

	return result, source

end



local function getPowerColorById(id)

	if not id then return DEFAULT_POWER_COLOR end

	local cached = colorByIdCache[id]

	if cached then return cached end

	local ok, col, src = pcall(resolvePowerColor, id)

	if not ok then col, src = DEFAULT_POWER_COLOR, "default" end

	colorByIdCache[id] = col

	colorSourceById[id] = src

	return col

end



local function getCharacterPowerColor(c)

	if not c then return DEFAULT_POWER_COLOR end

	for _, a in ipairs(COLOR_ATTRS) do

		local col = toColor3(c:GetAttribute(a))

		if col then return col end

	end

	local id = c:GetAttribute("NameTag") or c:GetAttribute("Character") or c.Name

	return getPowerColorById(id)

end



local function colorToHex(c)

	if not c then return "#facc15" end

	return string.format("#%02x%02x%02x",

		math.clamp(math.floor(c.R * 255 + 0.5), 0, 255),

		math.clamp(math.floor(c.G * 255 + 0.5), 0, 255),

		math.clamp(math.floor(c.B * 255 + 0.5), 0, 255))

end



local function getPlayerCharacterName(p, c)

	c = c or (p and p.Character)

