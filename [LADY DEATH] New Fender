local cachedProfile, cachedProfileAt = nil, 0



local function getAuthoritativeProfile()

	local now = os.clock()

	if cachedProfile and cachedProfile.Parent and now - cachedProfileAt < 1 then return cachedProfile end

	local auth = nil

	if AbilityController and AbilityController.OnCharacterAdded and debug and debug.getupvalues then

		pcall(function()

			local upvals = debug.getupvalues(AbilityController.OnCharacterAdded)

			if type(upvals) == "table" and typeof(upvals[5]) == "Instance" and upvals[5]:IsA("ScreenGui") then

				auth = upvals[5]

			end

		end)

	end

	cachedProfile = auth or PlayerGui:FindFirstChild("Profile")

