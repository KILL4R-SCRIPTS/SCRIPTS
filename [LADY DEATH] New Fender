		end
		wheel.InputBegan:Connect(function(inp)
			if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
				dragWheel = true; updWheel(inp.Position.X, inp.Position.Y)
			end
		end)
		valBar.InputBegan:Connect(function(inp)
			if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
				dragVal = true; updVal(inp.Position.X)
			end
		end)
		table.insert(connections, UserInputService.InputChanged:Connect(function(inp)
			if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
				if dragWheel then updWheel(inp.Position.X, inp.Position.Y) elseif dragVal then updVal(inp.Position.X) end
			end
		end))
		table.insert(connections, UserInputService.InputEnded:Connect(function(inp)
			if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
				dragWheel = false; dragVal = false
			end
		end))
		local function togglePanel()
			panel.Visible = not panel.Visible
			wrap.Size = UDim2.new(1, 0, 0, panel.Visible and 198 or 28)
		end
		topRow.MouseButton1Click:Connect(togglePanel)
		swatch.MouseButton1Click:Connect(togglePanel)
		return wrap
	end
	return sec
end

local kwTabList = {}
local firstTab = nil
local function selectKwTab(name)
	activeTabLbl.Text = tostring(name)
	for _, t in ipairs(kwTabList) do
		local active = (t.name == name)
		t.page.Visible = active
		t.accentBar.Visible = active
		kwTween(t.btn, { BackgroundColor3 = active and KW_T.Control or KW_T.Sidebar, BackgroundTransparency = active and 0 or 1 }, 0.12)
		t.lbl.TextColor3 = active and KW_T.Text or KW_T.SubText
	end
end

local function addTab(name, iconKey)
	local btn = kwNew("TextButton", { Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = KW_T.Control, BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, tabBar)
	kwRound(btn, 7)
	local accentBar = kwNew("Frame", { Size = UDim2.fromOffset(3, 16), Position = UDim2.new(0, 4, 0.5, -8), BackgroundColor3 = KW_T.Accent, BorderSizePixel = 0, Visible = false }, btn)
	kwRound(accentBar, 2)
	local lbl = kwText(btn, { Size = UDim2.new(1, -18, 1, 0), Position = UDim2.fromOffset(14, 0), Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = KW_T.SubText, Text = name })
	local page = kwNew("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = KW_T.Accent,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		Visible = false,
	}, pagesHost)
	kwPad(page, 14, 10)
	kwNew("UIListLayout", { Padding = UDim.new(0, 8) }, page)
	local sec = makeSectionApi(page)
	local tObj = { name = name, btn = btn, lbl = lbl, accentBar = accentBar, page = page, Select = function() selectKwTab(name) end }
	table.insert(kwTabList, tObj)
	if not firstTab then firstTab = tObj end
	btn.MouseButton1Click:Connect(function() selectKwTab(name) end)
	return sec
end

local function section(parent, title)
	return parent:Header({ Text = tostring(title or "") })
end

local function toggle(parent, title, default, callback)
	local tObj = parent:Toggle(nextFlag(title), title, { Default = default and true or false }, function(v)
		pcall(callback, v)
	end)
	pcall(function()
		if tObj.UpdateState then tObj:UpdateState(default and true or false) end
	end)
	return tObj
end

local function slider(parent, title, minV, maxV, step, default, callback)
	return parent:Slider(nextFlag(title), title, minV, maxV, default or minV, "Round", function(v)
		local st = step or 1
		local snapped = math.clamp(math.floor((v / st) + 0.5) * st, minV, maxV)
		pcall(callback, snapped)
	end)
end

local function button(parent, label, callback)
	return parent:Button({ Name = label, Callback = function() pcall(callback) end })
end

local function colorPicker(parent, title, defaultCol, callback)
	return parent:ColorPicker(title, defaultCol, callback)
end

