local function collectCandySweep()

	local c = LocalPlayer.Character

	local hrp = c and c:FindFirstChild("HumanoidRootPart")

	if not hrp then return 0 end

	local savedCF = hrp.CFrame

	local collected = 0

	-- Helper: instantly sweep all dropped candies/candycorn/lollipops (touch parts)

	local function vacuumNearbyCandy(radius)

		local myPos = hrp.Position

		for _, item in ipairs(workspace:GetDescendants()) do

			if item:IsA("BasePart") and item.Parent and not item:FindFirstChildOfClass("ProximityPrompt") then

				local iName = item.Name:lower()

				local full = item:GetFullName():lower()

				if not full:find("witches") and not full:find("wicthes") then

					if iName:find("candy") or iName:find("lollipop") or iName:find("candycorn") or iName:find("treat") then

						local dist = (item.Position - myPos).Magnitude

						if not radius or dist <= radius then

							hrp.CFrame = item.CFrame * CFrame.new(0, 0.5, 0)

							if firetouchinterest then

								pcall(firetouchinterest, hrp, item, 0)

								task.wait(0.03)

								pcall(firetouchinterest, hrp, item, 1)

							end

							task.wait(0.14)

							collected += 1

						end

					end

				end

			end

		end

	end

	-- PRIORITY 1: ALWAYS COLLECT ALL WORLD CANDY DROPS FIRST

	vacuumNearbyCandy(nil)

	-- PRIORITY 2: HARVEST PUMPKINS & PRESENTS (PROXIMITY PROMPTS)

	for _, inst in ipairs(workspace:GetDescendants()) do

		if not state.candyAutofarm then break end

		if inst:IsA("ProximityPrompt") and inst.Enabled then

			local full = inst:GetFullName():lower()

			local act = (inst.ActionText or ""):lower()

			local obj = (inst.ObjectText or ""):lower()

			local pName = (inst.Parent and inst.Parent.Name or ""):lower()

			if not full:find("witches") and not full:find("wicthes") and not full:find("bellprompt") and not obj:find("witches") then

				if full:find("pumpkin") or full:find("gift") or full:find("candy") or full:find("treat") or full:find("present")

					or obj:find("pumpkin") or obj:find("gift") or obj:find("candy") or obj:find("treat") or obj:find("present")

					or act:find("pumpkin") or act:find("gift") or act:find("candy") or act:find("treat") or act:find("take") or act:find("grab")

					or pName:find("pumpkin") or pName:find("gift") or pName:find("candy") or pName:find("present") then

					local part = inst.Parent:IsA("BasePart") and inst.Parent or inst.Parent:FindFirstChildWhichIsA("BasePart", true)

					if part then

						hrp.CFrame = part.CFrame * CFrame.new(0, 0, 2.2)

						task.wait(0.20)

						inst.HoldDuration = 0

						inst.RequiresLineOfSight = false

						inst.MaxActivationDistance = 32

						if fireproximityprompt then pcall(fireproximityprompt, inst) end

						task.wait(0.24)

						collected += 1

						-- Vacuum any candy that spawned right next to this pumpkin/gift!

						vacuumNearbyCandy(28)

					end

				end

			end

		end

	end

	-- PRIORITY 3: RING HOUSE DOORBELLS & IMMEDIATELY VACUUM SPAWNED CANDY

	for _, inst in ipairs(workspace:GetDescendants()) do

		if not state.candyAutofarm then break end

		if inst:IsA("ClickDetector") then

			local full = inst:GetFullName():lower()

			local pName = inst.Parent and inst.Parent.Name:lower() or ""

			if (full:find("house") or pName:find("doorbell") or pName:find("bell")) and not full:find("witches") and not full:find("wicthes") then

				local part = inst.Parent:IsA("BasePart") and inst.Parent or inst.Parent:FindFirstChildWhichIsA("BasePart", true)

				if part then

					hrp.CFrame = part.CFrame * CFrame.new(0, 0, 2.0)

					task.wait(0.22)

					if fireclickdetector then

						pcall(fireclickdetector, inst)

					end

					-- Brisk dwell for candy drop, then vacuum immediately

					task.wait(0.35)

					vacuumNearbyCandy(35)

					collected += 1

				end

			end

		end

	end

	if hrp and hrp.Parent and not state.inSafeSpot then hrp.CFrame = savedCF end

	return collected

end



local function claimAllAvailableQuests()

	local claimed = 0

	pcall(function()

		if not Knit then return end

		local QuestService = Knit.GetService("QuestService")

		if QuestService and QuestService.GetState then

			local qState = QuestService:GetState()

			if type(qState) == "table" then

				for _, kind in ipairs({ "Daily", "Weekly" }) do

					local cat = qState[kind]

					if type(cat) == "table" and type(cat.Quests) == "table" then

						for idx, q in pairs(cat.Quests) do

							if q.Progress and q.Required and q.Progress >= q.Required and not q.Claimed then

								pcall(function() QuestService:Claim(kind, idx) end)

								claimed += 1

							end

						end

						if cat.Bonus and not cat.BonusClaimed then

							pcall(function() QuestService:ClaimBonus(kind) end)

							claimed += 1

						end

					end

				end

			end

		end

		local bqs = Knit.GetService("BonnieQuestService")

		if bqs and bqs.BonnieCollect then pcall(function() bqs.BonnieCollect:Fire() end) end

		local fqs = Knit.GetService("FantasmaQuestService")

		if fqs and fqs.FantasmaCollect then pcall(function() fqs.FantasmaCollect:Fire() end) end

		local kqs = Knit.GetService("KnittingQuestService")

		if kqs and kqs.Completed then pcall(function() kqs.Completed:Fire() end) end

	end)

	return claimed

end



