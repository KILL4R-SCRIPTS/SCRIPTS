		local valKnob = new("Frame", { Size = UDim2.fromOffset(12, 18), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(currentVal, 0, 0.5, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 3 }, valTrack)

		round(valKnob, 6)

		outline(valKnob, Color3.new(0,0,0), 1)

		local valHit = new("TextButton", { Size = UDim2.new(1, 0, 1, 10), Position = UDim2.new(0, 0, 0, -5), BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, valTrack)

		-- Hex input box

		text(outer, { Size = UDim2.new(0.4, 0, 0, 16), Position = UDim2.fromOffset(rightX, 76), Text = "HEX CODE", TextColor3 = Theme.sub, Font = FONT_BOLD, TextSize = 9 })

		local hexBoxContainer = new("Frame", { Size = UDim2.new(1, -(rightX + 14), 0, 24), Position = UDim2.fromOffset(rightX, 94), BackgroundColor3 = Theme.input or Color3.fromRGB(20, 22, 28), BorderSizePixel = 0 }, outer)

		round(hexBoxContainer, 6)

