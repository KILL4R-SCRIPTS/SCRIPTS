		round(pickerKnob, 8)

		outline(pickerKnob, Color3.new(0, 0, 0), 2)

		local function updatePickerPos()

			local radius = wheel.AbsoluteSize.X > 0 and (wheel.AbsoluteSize.X / 2) or 65

			local r = currentSat * (radius - 4)

			local angle = math.pi * (1 - 2 * currentHue)

			local x = radius + r * math.cos(angle)

			local y = radius + r * math.sin(angle)

			pickerKnob.Position = UDim2.fromOffset(x, y)

		end

		-- Right side: Brightness / Value bar + Hex input + Presets

