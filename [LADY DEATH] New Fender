		local function findCharacterModel(name)

			if not name then return nil end

			local clean = tostring(name):lower():gsub("[%s%-_%:]", "")

			-- 1. Explicit Alias Map

			local aliasMap = {

				["greenwitch"] = "GreenWitch",

				["thegreenwitch"] = "GreenWitch",

				["glinda"] = "ZatannaGlinda",

				["thegoodwitch"] = "ZatannaGlinda",

				["goodwitch"] = "ZatannaGlinda",

				["zatannaglinda"] = "ZatannaGlinda",

				["riovidal"] = "RioVidal",

				["rio"] = "RioVidal",

				["thedeath"] = "DeathQueen",

				["ladydeath"] = "DeathQueen",

				["deathqueen"] = "DeathQueen",

				["agathaharkness"] = "AgathaHarkness",

				["agatha"] = "AgathaHarkness",

				["agathaharknessaa"] = "AgathaHarknessAA",

				["allalong"] = "AgathaHarknessAA",

				["agathaallalong"] = "AgathaHarknessAA",

				["darkphoenix"] = "DarkPhoenixGala",

				["darkphoenixmaleficent"] = "DarkPhoenixMaleficent",

				["darkphoenixarmor"] = "DarkPhoenixArmor",

				["klarion"] = "Klarion",

				["childklarion"] = "ChildKlarion",

				["ladydav"] = "LadyDav",

				["masked"] = "Masked",

				["modeldiarsy"] = "Modeldiarsy",

				["polaris"] = "Polaris",

				["thesinger"] = "TheSinger",

				["wednesdayalice"] = "WednesdayAlice",

				["y2kmadison"] = "Y2KMadison",

				["elevencarrie"] = "ElevenCarrie",

				["zatannajustice"] = "ZatannaJustice",

				["zatannaprism"] = "ZatannaPrism",

				["qetsiyahcleo"] = "QetsiyahCleo",

				["theimpostorvictorian"] = "TheImpostorVictorian",

				["darkjosieprom"] = "DarkJosieProm",

				["darkjosienoir"] = "DarkJosieNoir",

				["darkjosie"] = "DarkJosie",

				["firstwitch"] = "FirstWitch",

				["harvestwitch"] = "HarvestWitch",

				["valak"] = "Valak",

				["drfacilier"] = "DrFacilier",

				["coraline"] = "Coraline"

			}

			local targetName = aliasMap[clean] or name

			-- Check Morphs folder first

			if morphs then

				local m = morphs:FindFirstChild(targetName)

				if m then return m end

				for _, c in ipairs(morphs:GetChildren()) do

					local cClean = c.Name:lower():gsub("[%s%-_%:]", "")

					if cClean == clean or cClean:find(clean, 1, true) or clean:find(cClean, 1, true) then

						return c

					end

				end

			end

			-- Check CharactersSelection second

			if charsSel then

				local m = charsSel:FindFirstChild(targetName)

				if m then return m end

				for _, c in ipairs(charsSel:GetChildren()) do

					local cClean = c.Name:lower():gsub("[%s%-_%:]", "")

					if cClean == clean or cClean:find(clean, 1, true) or clean:find(cClean, 1, true) then

						return c

					end

				end

			end

			-- Check Assets.Characters third

			if charsFolder then

				local f = charsFolder:FindFirstChild(targetName)

				if f and f:FindFirstChild("Morph") then

					return f.Morph:FindFirstChild(f.Name) or f.Morph:FindFirstChildOfClass("Model")

				end

				for _, c in ipairs(charsFolder:GetChildren()) do

					local cClean = c.Name:lower():gsub("[%s%-_%:]", "")

					if cClean == clean or cClean:find(clean, 1, true) or clean:find(cClean, 1, true) then

						local morph = c:FindFirstChild("Morph")

						if morph then

							return morph:FindFirstChild(c.Name) or morph:FindFirstChildOfClass("Model")

						end

					end

				end

			end

			return nil

		end

		local function updateBottomLeftPortrait(targetModel)

	if not targetModel then return end

	pcall(function()

		local pgui = LocalPlayer:FindFirstChildOfClass("PlayerGui")

		local profile = pgui and pgui:FindFirstChild("Profile")

		if not profile then return end

		for _, vf in ipairs(profile:GetDescendants()) do

			if vf:IsA("ViewportFrame") and (vf.Name == "ViewportFrame" or (vf.Parent and vf.Parent.Name == "Background")) then

				local oldModel = vf:FindFirstChild("Model")

				if oldModel then

					pcall(function() oldModel:Destroy() end)

				end

				local clone = targetModel:Clone()

				clone.Name = "Model"

				local head = clone:FindFirstChild("Head") or clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart")

				if head then

					local headPos = head.Position

					clone:PivotTo(CFrame.new(-headPos) * clone:GetPivot())

				end

				for _, p in ipairs(clone:GetDescendants()) do

					if p:IsA("BasePart") then

						p.Anchored = true

						p.CanCollide = false

					end

				end

				clone.Parent = vf

				local cam = vf.CurrentCamera or vf:FindFirstChildOfClass("Camera")

				if not cam then

					cam = Instance.new("Camera")

					cam.Name = "Camera"

					cam.Parent = vf

					vf.CurrentCamera = cam

				end

				cam.CFrame = CFrame.new(Vector3.new(0, 0, -2.4), Vector3.new(0, 0, 0))

			end

		end

		local pImg = profile:FindFirstChild("ProfileImage", true)

		if pImg and pImg:IsA("ImageLabel") then

			pImg.ImageTransparency = 1

		end

	end)

