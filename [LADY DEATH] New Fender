-- INSTANT INTERACT (Fixes CustomPrompt by setting HoldDuration=0 BEFORE PromptShown)
-- ============================================================================
local savedPromptDurations = setmetatable({}, { __mode = "k" })
local function patchPrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") then return end
	if savedPromptDurations[prompt] == nil then
		savedPromptDurations[prompt] = prompt.HoldDuration
	end
	pcall(function()
		prompt.HoldDuration = state.instantInteract and 0 or savedPromptDurations[prompt]
	end)
end

local function applyInstantInteractAll()
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") then patchPrompt(d) end
	end
end

