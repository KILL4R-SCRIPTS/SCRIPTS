		-- Quick Presets row

		text(outer, { Size = UDim2.new(1, -28, 0, 14), Position = UDim2.fromOffset(14, 178), Text = "QUICK PRESETS", TextColor3 = Theme.sub, Font = FONT_BOLD, TextSize = 9 })

		local presetsHolder = new("Frame", { Size = UDim2.new(1, -28, 0, 32), Position = UDim2.fromOffset(14, 196), BackgroundTransparency = 1 }, outer)

		local presetLayout = new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Left, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 7) }, presetsHolder)

		local presets = {

			{ name = "Emerald", col = Color3.fromRGB(0, 235, 117) },

			{ name = "Crimson", col = Color3.fromRGB(255, 30, 64) },

			{ name = "Void", col = Color3.fromRGB(157, 0, 255) },

			{ name = "Cyan", col = Color3.fromRGB(0, 245, 255) },

			{ name = "Gold", col = Color3.fromRGB(255, 215, 0) },

			{ name = "Pink", col = Color3.fromRGB(255, 64, 160) },

			{ name = "White", col = Color3.fromRGB(255, 255, 255) },

			{ name = "Pitch", col = Color3.fromRGB(20, 20, 24) }

		}

		local function sync(silent)

			currentColor = Color3.fromHSV(currentHue, currentSat, currentVal)

			previewPill.BackgroundColor3 = currentColor

			hexLabel.Text = "#" .. currentColor:ToHex():upper()

			hexLabel.TextColor3 = (currentVal > 0.5 and currentSat < 0.6) and Color3.new(0,0,0) or WHITE

