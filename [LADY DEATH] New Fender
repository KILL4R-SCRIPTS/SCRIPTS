local function isInstantRitualPrompt(prompt)

	if not prompt or not prompt:IsA("ProximityPrompt") then return false end

	local full = prompt:GetFullName():lower()

	local objText = (prompt.ObjectText or ""):lower()

	local actText = (prompt.ActionText or ""):lower()

	local parentName = prompt.Parent and prompt.Parent.Name:lower() or ""

	if full:find("moramiserium", 1, true) or full:find("expression", 1, true) or full:find("infinitystone", 1, true)

		or full:find("darkhold", 1, true) or full:find("hellfire", 1, true) or full:find("descensum", 1, true)

		or full:find("pumpkin", 1, true) or full:find("gift", 1, true) or full:find("destroytotemprompt", 1, true)

		or full:find("reddoor", 1, true) or full:find("pendant", 1, true) or full:find("pendanttrap", 1, true) or full:find("doorexit", 1, true)

		or objText:find("dark magic", 1, true) or objText:find("express your wishes", 1, true) or objText:find("expression", 1, true)

		or objText:find("pumpkin", 1, true) or objText:find("gift", 1, true)

		or objText:find("door", 1, true) or objText:find("escape", 1, true) or objText:find("exit", 1, true)

		or actText:find("escape", 1, true) or actText:find("exit", 1, true) or actText:find("open", 1, true)

		or parentName == "expressionpart" or (parentName == "handle" and full:find("mora", 1, true))

		or (parentName == "rootpart" and full:find("infinity", 1, true)) or parentName:find("pumpkin")

		or parentName == "reddoor" or parentName:find("door") then

		return true

	end

	return false

end



local function applyInstantPrompt(p)

	if not state.instantRituals and not state.autoEscapePendant then return end

	if isInstantRitualPrompt(p) then

		pcall(function()

			p.HoldDuration = 0

			p.ClickablePrompt = true

			p.RequiresLineOfSight = false

			p.MaxActivationDistance = math.max(p.MaxActivationDistance, 30)

		end)

	end

end



local function applyAllInstantPrompts()

	if not state.instantRituals then return end

	for _, inst in ipairs(workspace:GetDescendants()) do

		if inst:IsA("ProximityPrompt") then applyInstantPrompt(inst) end

	end

end



