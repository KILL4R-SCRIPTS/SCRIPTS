local origResolveMouseTarget = nil
local origGetTargetModel = nil
local origAssistRadius = nil
local function getEffectiveAimRange()
	local ab = TargetAssistMod and TargetAssistMod.EquippedAbility
	local cfg = (type(ab) == "string" and AbilityConfig) and AbilityConfig[ab] or nil
	if type(cfg) == "table" and tonumber(cfg.Range) and cfg.Range > 0 then
		return math.min(state.spamRange, cfg.Range)
	end
	return state.spamRange
end

if TargetAssistMod then
	origAssistRadius = TargetAssistMod.ASSIST_RADIUS
	if type(TargetAssistMod.ResolveMouseTarget) == "function" then
		origResolveMouseTarget = TargetAssistMod.ResolveMouseTarget
		TargetAssistMod.ResolveMouseTarget = function(self, ...)
			if state.silentAim and state.equippedSpammer then
				local t = getNearestTarget(getEffectiveAimRange())
				local thrp = t and getHRP(t)
				if thrp then
					return thrp, thrp.Position
				end
			end
			return origResolveMouseTarget(self, ...)
		end
	end
	if type(TargetAssistMod.GetTargetModel) == "function" then
		origGetTargetModel = TargetAssistMod.GetTargetModel
		TargetAssistMod.GetTargetModel = function(self, ...)
			if state.silentAim and state.equippedSpammer then
				local t = getNearestTarget(getEffectiveAimRange())
				if t then return t end
			end
			return origGetTargetModel(self, ...)
		end
	end
end

local function getEquippedAbilityName()
	if TargetAssistMod and type(TargetAssistMod.EquippedAbility) == "string" and TargetAssistMod.EquippedAbility ~= "" then
		return TargetAssistMod.EquippedAbility
	end
	local eq = PlayerGui:FindFirstChild("EquippedItemName")
	if eq then
		for _, d in ipairs(eq:GetDescendants()) do
			if d:IsA("TextLabel") and d.Name == "ItemName" and d.Text ~= "" then
				return d.Text
			end
		end
	end
	return nil
end

local function hasAbilityType(cfg, typeName)
	if type(cfg) == "table" then
		if cfg.AbilityType == typeName then return true end
		if cfg.Types and type(cfg.Types.AbilityTypes) == "table" then
			for _, t in ipairs(cfg.Types.AbilityTypes) do
				if t == typeName then return true end
			end
		end
	end
	return false
end

local function fireEquippedAbility(abName, targetChar)
	if not ExecuteRemote or not abName or abName == "" then return end
	local cfg = AbilityConfig and AbilityConfig[abName]
	local targetHrp = targetChar and getHRP(targetChar)
	local cam = workspace.CurrentCamera
	if AimInfoRemote and cam then
		if state.silentAim and targetHrp then
			pcall(function()
				AimInfoRemote:FireServer(cam.CFrame.Position, targetHrp.Position, targetHrp, targetHrp.Position, true)
			end)
		else
			local fallbackPos = cam.CFrame.Position + cam.CFrame.LookVector * 80
			pcall(function()
				AimInfoRemote:FireServer(cam.CFrame.Position, fallbackPos, nil, fallbackPos, false)
			end)
		end
	end
	local isPrepClick = hasAbilityType(cfg, "PrepClick")
	pcall(function()
		if EndSpawnProtRemote then EndSpawnProtRemote:FireServer() end
	end)
	if isPrepClick then
		pcall(function()
			ExecuteRemote:FireServer(abName, cfg, true)
			ExecuteRemote:FireServer(abName, cfg, false)
		end)
	else
		local predOk, pred = pcall(function()
			return CastPredictionMod and CastPredictionMod.Begin and CastPredictionMod.Begin(abName)
		end)
		pcall(function()
			ExecuteRemote:FireServer(abName, cfg, nil, (predOk and pred) and "Predicted" or nil)
		end)
	end
end

