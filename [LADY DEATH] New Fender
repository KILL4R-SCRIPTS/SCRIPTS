local function applyMorphInPlace(targetName)

			local c = LocalPlayer.Character

			if not c then return false end

			local targetModel = findCharacterModel(targetName)

			if not targetModel then

				targetModel = findCharacterModel(selectedSkin ~= "Default" and selectedSkin or selectedChar)

			end

			if not targetModel then return false end

			local bodyPartNames = {

				"Head", "UpperTorso", "LowerTorso",

				"LeftUpperArm", "LeftLowerArm", "LeftHand",

				"RightUpperArm", "RightLowerArm", "RightHand",

				"LeftUpperLeg", "LeftLowerLeg", "LeftFoot",

				"RightUpperLeg", "RightLowerLeg", "RightFoot"

			}

			-- 1. Thoroughly remove all previous clothing, accessories, extra models/parts, and morph tags

			for _, item in ipairs(c:GetChildren()) do

				if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") then

					pcall(function() item:Destroy() end)

				elseif item:GetAttribute("KW_Morph") then

					pcall(function() item:Destroy() end)

				elseif not table.find(bodyPartNames, item.Name) and item.Name ~= "HumanoidRootPart" and item.Name ~= "Humanoid" and item.Name ~= "Animate" and item.Name ~= "Health" and item.Name ~= "Value" and item.Name ~= "RagdollConstraints" and item.Name ~= "CharacterInfo" and item.Name ~= "Effects" and item.Name ~= "Animations" then

					-- Extra top-level meshes, horns, collars, wings, capes left behind from previous morphs

					pcall(function() item:Destroy() end)

				end

			end

			for _, d in ipairs(c:GetDescendants()) do

				if d:GetAttribute("KW_Morph") then

					pcall(function() d:Destroy() end)

				end

			end

			-- 2. Strip visual parts/decals/meshes from each limb (preserving only Motor6D joints and attachments)

			for _, partName in ipairs(bodyPartNames) do

				local myPart = c:FindFirstChild(partName)

				if myPart then

					for _, child in ipairs(myPart:GetChildren()) do

						if child:IsA("MeshPart") or child:IsA("Model") or child:IsA("Folder") or child:IsA("Decal") or child:IsA("SpecialMesh") or (child:IsA("BasePart") and not child:IsA("Motor6D")) then

							pcall(function() child:Destroy() end)

						end

					end

				end

			end

			-- 3. Rig transplant from targetModel with individual preservation of part relative offsets

			for _, partName in ipairs(bodyPartNames) do

				local myPart = c:FindFirstChild(partName)

				local tPart = targetModel:FindFirstChild(partName)

				if myPart and tPart then

					pcall(function()

						myPart.Color = tPart.Color

						myPart.Material = tPart.Material

						myPart.Transparency = tPart.Transparency

					end)

					for _, child in ipairs(tPart:GetChildren()) do

						if child:IsA("Decal") or child:IsA("SpecialMesh") then

							local clone = child:Clone()

							clone:SetAttribute("KW_Morph", true)

							clone.Parent = myPart

						elseif child:IsA("BasePart") then

							local clone = child:Clone()

							clone:SetAttribute("KW_Morph", true)

							clone.CanCollide = false

							clone.Anchored = false

							clone.CFrame = myPart.CFrame * (tPart.CFrame:Inverse() * child.CFrame)

							local weld = clone:FindFirstChildOfClass("WeldConstraint") or Instance.new("WeldConstraint")

							weld.Part0 = clone

							weld.Part1 = myPart

							weld.Parent = clone

							clone.Parent = myPart

						elseif child:IsA("Model") or child:IsA("Folder") then

							local clone = child:Clone()

							clone:SetAttribute("KW_Morph", true)

							for _, sub in ipairs(clone:GetDescendants()) do

								if sub:IsA("BasePart") then

									sub.CanCollide = false

									sub.Anchored = false

									sub:SetAttribute("KW_Morph", true)

									local origCF = sub.CFrame

									sub.CFrame = myPart.CFrame * (tPart.CFrame:Inverse() * origCF)

									local weld = sub:FindFirstChildOfClass("WeldConstraint") or Instance.new("WeldConstraint")

									weld.Part0 = sub

									weld.Part1 = myPart

									weld.Parent = sub

								end

							end

							clone.Parent = myPart

						end

					end

				end

			end

			-- 4. Top-level props/models/accessories/clothing

			-- Copy 2D clothing (Shirt, Pants, ShirtGraphic, BodyColors)

			for _, item in ipairs(targetModel:GetChildren()) do

				if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") then

					local clone = item:Clone()

					clone:SetAttribute("KW_Morph", true)

					clone.Parent = c

				end

			end

			-- Copy 3D Accessories via Humanoid:AddAccessory

			local myHumForAcc = c:FindFirstChildOfClass("Humanoid")

			for _, item in ipairs(targetModel:GetChildren()) do

				if item:IsA("Accessory") then

					local clone = item:Clone()

					clone:SetAttribute("KW_Morph", true)

					if myHumForAcc then

						pcall(function() myHumForAcc:AddAccessory(clone) end)

					else

						clone.Parent = c

					end

				end

			end

			-- Copy Top-level models / parts (robes, dresses, capes, handheld items) and rebind welds to c

			local targetRoot = targetModel.PrimaryPart or targetModel:FindFirstChild("HumanoidRootPart") or targetModel:FindFirstChild("UpperTorso")

			local myRoot = c.PrimaryPart or c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso")

			local attachTarget = c:FindFirstChild("UpperTorso") or myRoot

			for _, item in ipairs(targetModel:GetChildren()) do

				if not table.find(bodyPartNames, item.Name) and item.Name ~= "HumanoidRootPart" and item.Name ~= "Humanoid" and item.Name ~= "Animate" and item.Name ~= "Animations" and item.Name ~= "Value" and item.Name ~= "Health" and not item:IsA("Accessory") and not item:IsA("Shirt") and not item:IsA("Pants") and not item:IsA("BodyColors") and not item:IsA("ShirtGraphic") then

					if item:IsA("Model") or item:IsA("BasePart") or item:IsA("Folder") then

						local clone = item:Clone()

						clone:SetAttribute("KW_Morph", true)

						for _, sub in ipairs(clone:GetDescendants()) do

							if sub:IsA("BasePart") then

								sub.CanCollide = false

								sub.Anchored = false

								sub:SetAttribute("KW_Morph", true)

								local origCF = sub.CFrame

								if targetRoot and myRoot then

									sub.CFrame = myRoot.CFrame * (targetRoot.CFrame:Inverse() * origCF)

								end

							elseif sub:IsA("JointInstance") or sub:IsA("WeldConstraint") then

								if sub.Part0 and sub.Part0:IsDescendantOf(targetModel) then

									local match = c:FindFirstChild(sub.Part0.Name, true)

									if match then sub.Part0 = match end

								end

								if sub.Part1 and sub.Part1:IsDescendantOf(targetModel) then

									local match = c:FindFirstChild(sub.Part1.Name, true)

									if match then sub.Part1 = match end

								end

							end

						end

						if clone:IsA("BasePart") then

							clone.CanCollide = false

							clone.Anchored = false

							clone:SetAttribute("KW_Morph", true)

							local origCF = clone.CFrame

							if targetRoot and myRoot then

								clone.CFrame = myRoot.CFrame * (targetRoot.CFrame:Inverse() * origCF)

							end

							local weld = clone:FindFirstChildOfClass("WeldConstraint") or Instance.new("WeldConstraint")

							weld.Part0 = clone

							weld.Part1 = attachTarget

							weld.Parent = clone

						end

						clone.Parent = c

					end

				end

			end

			-- 5. Humanoid scale proportions

			local myHum = c:FindFirstChildOfClass("Humanoid")

			local tHum = targetModel:FindFirstChildOfClass("Humanoid")

			if myHum and tHum then

				for _, scaleName in ipairs({"BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale", "BodyProportionScale", "BodyTypeScale"}) do

					local s = tHum:FindFirstChild(scaleName)

					local ms = myHum:FindFirstChild(scaleName)

					if s and ms then

						ms.Value = s.Value

					end

				end

			end

			-- 6. Animations

			local tAnims = targetModel:FindFirstChild("Animations")

			if tAnims then

				local oldA = c:FindFirstChild("Animations")

				if oldA then pcall(function() oldA:Destroy() end) end

				local cloneA = tAnims:Clone()

				cloneA:SetAttribute("KW_Morph", true)

				cloneA.Parent = c

			end

			-- 7. Update NameTag

			pcall(function() c:SetAttribute("NameTag", targetModel.Name) end)

			-- 8. Visual Emerald Morph Burst Effect

			pcall(function()

				local root = c:FindFirstChild("HumanoidRootPart")

				if root then

					local att = Instance.new("Attachment", root)

					local pe = Instance.new("ParticleEmitter")

					pe.Color = ColorSequence.new({

						ColorSequenceKeypoint.new(0, Color3.fromRGB(120, 255, 170)),

						ColorSequenceKeypoint.new(0.5, Color3.fromRGB(60, 230, 130)),

						ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 160, 70))

					})

					pe.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 2.5), NumberSequenceKeypoint.new(1, 0)})

					pe.Rate = 140

					pe.Speed = NumberRange.new(6, 12)

					pe.SpreadAngle = Vector2.new(180, 180)

					pe.Parent = att

					task.delay(1, function()

						pe.Enabled = false

						task.wait(1.5)

						att:Destroy()

					end)

				end

			end)

			updateBottomLeftPortrait(targetModel)

			return true

		end

