	scanAndTrackWorldObject = function(inst)

		if not inst or not inst.Parent then return end

		if trackedWorldObjects[inst] then return end

		local full = inst:GetFullName():lower()

		local name = inst.Name:lower()

		local isTotem, isCrucifix, targetPart = false, false, nil

		if inst:IsA("ProximityPrompt") and inst.Name == "DestroyTotemPrompt" then

			pcall(function()

				inst.HoldDuration = 0

				inst.MaxActivationDistance = 35

				inst.RequiresLineOfSight = false

			end)

		end

		local model = inst:IsA("Model") and inst or inst:FindFirstAncestorOfClass("Model")

		if model and (model.Name == "Totem" or model.Name:lower():find("crucifix")) then

			targetPart = model.PrimaryPart or model:FindFirstChild("Mesh") or model:FindFirstChild("Totem") or model:FindFirstChildWhichIsA("BasePart", true)

			local breakSound = model:FindFirstChild("Break", true)

			if (breakSound and breakSound:IsA("Sound") and breakSound.SoundId:find("3750957896")) or model:FindFirstChild("Totem") or model.Name:lower():find("crucifix") then

				isCrucifix = true

			else

				isTotem = true

			end

		elseif inst:IsA("UnionOperation") then

			if inst.Name == "Mesh" and math.abs(inst.Size.X - 0.695) < 0.05 then targetPart = inst isTotem = true

			elseif inst.Name == "Totem" and math.abs(inst.Size.X - 2.087) < 0.1 then targetPart = inst isCrucifix = true end

		elseif inst:IsA("Sound") then

			if inst.SoundId:find("2978605361") then

				targetPart = inst:FindFirstAncestorWhichIsA("BasePart") or (inst.Parent and inst.Parent:FindFirstChildWhichIsA("BasePart", true))

				isTotem = true

			elseif inst.SoundId:find("3750957896") then

				targetPart = inst:FindFirstAncestorWhichIsA("BasePart") or (inst.Parent and inst.Parent:FindFirstChildWhichIsA("BasePart", true))

				isCrucifix = true

			end

		elseif (name:find("crucifix") or full:find("crucifix")) and (inst:IsA("BasePart") or inst:IsA("Model")) then

			targetPart = inst:IsA("BasePart") and inst or inst:FindFirstChildWhichIsA("BasePart", true)

			isCrucifix = true

		elseif (name:find("totem") or full:find("totem")) and not full:find("hoverboard") and not full:find("barreira") and (inst:IsA("BasePart") or inst:IsA("Model")) then

			targetPart = inst:IsA("BasePart") and inst or inst:FindFirstChildWhichIsA("BasePart", true)

			isTotem = true

		end

		-- Pumpkin/Gift ESP removed per request; only Totem / Crucifix are tracked now.

		if not targetPart or not targetPart:IsA("BasePart") then return end

		if trackedWorldObjects[targetPart] then return end

		local objType = isTotem and "Totem" or (isCrucifix and "Crucifix" or nil)

		if not objType then return end

		local bb = trackInst(new("BillboardGui", { Name = "KW_" .. objType .. "ESP", AlwaysOnTop = true, Size = UDim2.fromOffset(130, 48), StudsOffset = Vector3.new(0, 3, 0), ResetOnSpawn = false, Adornee = targetPart }, espFolder))

		local lbl = text(bb, { Size = UDim2.fromScale(1, 1), RichText = true, Font = FONT_BOLD, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center })

		local hl = trackInst(new("Highlight", { Name = "KW_" .. objType .. "Glow", DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, FillTransparency = 0.35, OutlineTransparency = 0, Adornee = (targetPart.Parent and targetPart.Parent:IsA("Model") and targetPart.Parent ~= workspace) and targetPart.Parent or targetPart }, espFolder))

		if isTotem then

			hl.FillColor = Color3.fromRGB(0, 140, 255)

			hl.OutlineColor = Color3.fromRGB(96, 165, 250)

		elseif isCrucifix then

			hl.FillColor = Color3.fromRGB(20, 20, 20)

			hl.OutlineColor = Color3.fromRGB(255, 255, 255)

		end

		trackedWorldObjects[targetPart] = { gui = bb, label = lbl, hl = hl, target = targetPart, type = objType }

		if isTotem or isCrucifix then

			state.latestTotemPart = targetPart

			state.latestTotemType = objType

		end

	end



