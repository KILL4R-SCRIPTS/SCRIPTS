local function getSortedExtraKeyButtons()

	local profile = getAuthoritativeProfile()

	if not profile then return {} end

	local ekh = profile:FindFirstChild("TemplateExtraKeysHolder") or profile:FindFirstChild("ExtraKeysHolder")

	if not ekh then return {} end

	local list = {}

	for _, c in ipairs(ekh:GetChildren()) do

		if c:IsA("GuiObject") and c.Visible then

			table.insert(list, c)

		end

	end

	table.sort(list, function(a, b)

		local na = tonumber(a.Name:match("%d+")) or 0

		local nb = tonumber(b.Name:match("%d+")) or 0

		return na < nb

	end)

	return list

end



local function resolveKeyToAbility(keyCode)

	local digitIndex = nil

	if keyCode == Enum.KeyCode.One then digitIndex = 1

	elseif keyCode == Enum.KeyCode.Two then digitIndex = 2

	elseif keyCode == Enum.KeyCode.Three then digitIndex = 3

	elseif keyCode == Enum.KeyCode.Four then digitIndex = 4

	elseif keyCode == Enum.KeyCode.Five then digitIndex = 5

	elseif keyCode == Enum.KeyCode.Six then digitIndex = 6

	elseif keyCode == Enum.KeyCode.Seven then digitIndex = 7

	elseif keyCode == Enum.KeyCode.Eight then digitIndex = 8

	elseif keyCode == Enum.KeyCode.Nine then digitIndex = 9

	end

	if digitIndex and isNewFender then

		-- Direct 1:1 match by button name first (avoids any 1-off shifting)

		local profile = getAuthoritativeProfile()

		local ekh = profile and (profile:FindFirstChild("TemplateExtraKeysHolder") or profile:FindFirstChild("ExtraKeysHolder"))

		if ekh then

			local directBtn = ekh:FindFirstChild("ExtraKey" .. digitIndex) or ekh:FindFirstChild(tostring(digitIndex))

			if directBtn and directBtn.Visible then

				return directBtn.Name

			end

		end

		local extraButtons = getSortedExtraKeyButtons()

		if extraButtons[digitIndex] then

			return extraButtons[digitIndex].Name

		end

		return "ExtraKey" .. digitIndex

	end

	return KEYCODE_TO_ABILITY[keyCode]

end



