	if c:GetAttribute("Shield") or c:GetAttribute("Shielding") then return true end

	if AbilityController and (AbilityController.CurrentAbility == "Q" or AbilityController.Concurrent == "Q") then return true end

	if c:FindFirstChild("Shield") or c:FindFirstChild("ShieldVFX") or c:FindFirstChild("DefenseShield") then return true end

	return false

end



